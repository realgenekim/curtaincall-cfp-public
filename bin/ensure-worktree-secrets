#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
common_root="$(git worktree list --porcelain | awk '/^worktree / && !found {print substr($0, 10); found=1}')"
source_dir="$common_root/secrets"
target_dir="$repo_root/secrets"

if [ -e "$target_dir" ] || [ -L "$target_dir" ]; then
  test -r "$target_dir/google-oauth-client.txt" || {
    echo "✗ $target_dir exists but google-oauth-client.txt is unreadable" >&2
    exit 1
  }
  test -r "$target_dir/db.edn" || {
    echo "✗ $target_dir exists but db.edn is unreadable" >&2
    exit 1
  }
  test "$(wc -c < "$target_dir/session-cookie-key.txt" | tr -d ' ')" = "16" || {
    echo "✗ $target_dir/session-cookie-key.txt must exist and be exactly 16 bytes" >&2
    exit 1
  }
  echo "✓ worktree secrets available"
  exit 0
fi

test -r "$source_dir/google-oauth-client.txt" || {
  echo "✗ canonical worktree secret is unavailable: $source_dir/google-oauth-client.txt" >&2
  exit 1
}
test -r "$source_dir/db.edn" || {
  echo "✗ canonical worktree database config is unavailable: $source_dir/db.edn" >&2
  exit 1
}
test "$(wc -c < "$source_dir/session-cookie-key.txt" | tr -d ' ')" = "16" || {
  echo "✗ canonical session-cookie-key.txt must exist and be exactly 16 bytes" >&2
  exit 1
}

ln -s "$source_dir" "$target_dir"
echo "✓ linked ignored worktree secrets from the canonical checkout"
