  || { echo "FAIL live-tree lock refusal was not named" >&2; exit 1; }
wait "$orphan_lock_holder_pid" 2>/dev/null || true
if kill -0 "$orphan_child_pid" 2>/dev/null; then
  echo "FAIL lock holder released before the old foreground child terminated" >&2
  exit 1
