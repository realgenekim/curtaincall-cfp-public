[[ "$(grep -Ec '^[[:space:]]*(exec[[:space:]]+)?timeout[[:space:]]+' "$tmp/new-runner" || true)" = 0 ]] \
  || { echo "FAIL runner still invokes GNU timeout" >&2; exit 1; }
