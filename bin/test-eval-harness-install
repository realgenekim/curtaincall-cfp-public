  || { echo "FAIL runner did not reacquire the kernel lock after SIGKILL" >&2; exit 1; }
chmod 0755 "$verify_runtime"
if HOME="$verify_home" \
    FLEET_INSTALL_AUTHORITY_ROOT="$verify_authority" \
