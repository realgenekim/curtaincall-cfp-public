if "$pair_repo/bin/reset-anvil-fleet" _test-find-preimage "$pair_head" "$runner_a_hash" "$lineage_y_hash" \
    >"$tmp/frankenstein.out" 2>"$tmp/frankenstein.err"; then
  echo "FAIL runner and lineage from different commits passed common-preimage proof" >&2
  exit 1
