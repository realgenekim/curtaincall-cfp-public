[[ "$positive_pair" == "$pair_head" ]] \
  || { echo "FAIL exact common preimage commit was not found" >&2; exit 1; }

control_paths="$(sed -n '/^start_remote() {/,/^}/p; /^resume_remote() {/,/^}/p; /^score_remote() {/,/^}/p' "$repo_root/bin/reset-anvil-fleet")"
if printf '%s\n' "$control_paths" | rg -n 'install .*hill-climb-fleet|scp .*hill-climb-fleet' >"$tmp/overwrite.out"; then
  cat "$tmp/overwrite.out" >&2
  echo "FAIL start/resume/score wrapper can still overwrite the receipted runtime" >&2
  exit 1
